projection;
strict ( 2 );
use side effects;

define behavior for ZC_PRC_ProcessedObject alias ProcessedObject
{
  use delete;
  use action resumeProcessing;
  use event objectProcessedTransition;
  use association _ProcessedStep;
}

define behavior for ZC_PRC_ProcessedStep
{
  use delete;
  use association _ProcessedObject;
}